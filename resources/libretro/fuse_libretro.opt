# games247 default core options for the ZX Spectrum (Fuse) core. Values here replace the core's
# own defaults. To change them for yourself, put a file with the same name in
# <games247 folder>/cores/options/ - its values win over these.
#
# Controller layout, matching the C64 (Xbox button labels; the RetroPad names are in brackets):
#   A [B]: fire
#   B [A]: joystick up, for games that jump with up
#   Y [X]: space bar
#   X [Y]: switch the joystick type: Kempston, Sinclair 1, Sinclair 2, Cursor. Spectrum games
#          each support some of these; Kempston is the most common.
# The games247_ lines are handled by games247's player rather than the core, see
# LibretroCore::applyButtonMap().
games247_controller_types = "Kempston Joystick|Sinclair 1 Joystick|Sinclair 2 Joystick|Cursor Joystick"
# Fuse itself has fire on RetroPad A and up on RetroPad B, the other way round from the C64.
games247_button_b = "a"
games247_button_a = "up"
games247_button_y = "next_controller"
fuse_joypad_x = "Space"

# Machine: each time a game starts, games247 asks which Spectrum to run it on. The +2 comes
# first as the best specced of the three (128K, and it runs nearly every 48K game too); pick
# the 48K for the odd old game that only works on one. To skip the question, set
# games247_machine_choice_option = "" in your own option file; games then run on the machine
# fuse_machine says.
fuse_machine = "Spectrum +2"
games247_machine_choice_title = "Spectrum model"
games247_machine_choice_option = "fuse_machine"
games247_machine_choice_values = "Spectrum +2|Spectrum 128K|Spectrum 48K"
games247_machine_choice_labels = "Spectrum +2|Spectrum 128K|Spectrum 48K"

# Video: show just the Spectrum's 256x192 screen. The core draws the full border and games247
# crops it, bringing it back while a tape's loading stripes run across it.
fuse_size_border = "full"
games247_crop_size = "256x192"
games247_border_while_loading = "enabled"

# Tapes: each time a tape game starts, games247 asks for Fast Load (instant) or Real Speed
# Load (the loading stripes and sounds as on the real machine, which takes a few minutes).
# To skip the question, set games247_load_choice_option = "" in your own option file; tapes
# then load as fuse_fast_load says.
fuse_fast_load = "enabled"
games247_load_choice_title = "Tape loading"
games247_load_choice_option = "fuse_fast_load"
games247_load_choice_values = "enabled|disabled"
games247_load_choice_labels = "Fast Load|Real Speed Load"
games247_load_choice_extensions = "tap|tzx|pzx|csw"

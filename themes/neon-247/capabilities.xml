<!--
    Theme capabilities for neon-247
-->

<themeCapabilities>
    <themeName>Neon</themeName>

    <aspectRatio>16:9</aspectRatio>
    <aspectRatio>16:10</aspectRatio>
    <aspectRatio>4:3</aspectRatio>
    <aspectRatio>21:9</aspectRatio>

    <variant name="neon">
        <label>Neon</label>
        <selectable>true</selectable>
    </variant>

    <!-- games247 extension: fade transitions are drawn as an old TV switching channels. -->
    <fadeStyle>crt</fadeStyle>

    <transitions name="crt">
        <label>CRT switch</label>
        <selectable>true</selectable>
        <systemToSystem>fade</systemToSystem>
        <systemToGamelist>fade</systemToGamelist>
        <gamelistToGamelist>fade</gamelistToGamelist>
        <gamelistToSystem>fade</gamelistToSystem>
        <startupToSystem>fade</startupToSystem>
        <startupToGamelist>fade</startupToGamelist>
    </transitions>

    <transitions name="crtAndSlide">
        <label>CRT switch and slide</label>
        <selectable>true</selectable>
        <systemToSystem>slide</systemToSystem>
        <systemToGamelist>fade</systemToGamelist>
        <gamelistToGamelist>slide</gamelistToGamelist>
        <gamelistToSystem>fade</gamelistToSystem>
        <startupToSystem>fade</startupToSystem>
        <startupToGamelist>fade</startupToGamelist>
    </transitions>
</themeCapabilities>
